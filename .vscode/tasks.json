{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "compile",
            "type": "shell",
            "command": "node",
            "args": [
                "node_modules/typescript/bin/tsc",
                "-p",
                "./",
                "--skipLibCheck"
            ],
            "problemMatcher": "$tsc",
            "presentation": {
                "reveal": "silent"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}

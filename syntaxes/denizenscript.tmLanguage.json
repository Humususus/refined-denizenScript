{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "DenizenScript",
    "scopeName": "source.denizenscript",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#tags"
        },
        {
            "include": "#commands"
        },
        {
            "include": "#keys"
        },
        {
            "include": "#operators"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "comment": "ANCHORED AT THE START OF THE LINE, and that anchor is load-bearing. Denizen has no end-of-line comment: ScriptChecker.cs:184 tests the TRIMMED line with StartsWith('#'), so a '#' anywhere else is ordinary argument text. Unanchored, this rule ran before every other pattern in the file and greyed out the rest of any line holding a '#' -- a hex colour such as <&color[#FF0000]>, a '#' inside a quoted string, or a channel name.",
                    "name": "comment.line.number-sign.denizenscript",
                    "match": "^\\s*#.*$"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.denizenscript",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "include": "#tags"
                        },
                        {
                            "name": "constant.character.escape.denizenscript",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "name": "string.quoted.single.denizenscript",
                    "begin": "'",
                    "end": "'",
                    "patterns": [
                        {
                            "include": "#tags"
                        }
                    ]
                }
            ]
        },
        "tags": {
            "patterns": [
                {
                    "name": "meta.tag.denizenscript",
                    "begin": "<",
                    "end": ">",
                    "patterns": [
                        {
                            "name": "variable.other.readwrite.denizenscript",
                            "match": "\\[([A-Za-z_][A-Za-z0-9_]*)\\]"
                        },
                        {
                            "name": "entity.name.function.denizenscript",
                            "match": "[A-Za-z_&][A-Za-z0-9_&-]*"
                        },
                        {
                            "name": "punctuation.separator.period.denizenscript",
                            "match": "\\."
                        },
                        {
                            "name": "punctuation.definition.arguments.begin.denizenscript",
                            "match": "\\["
                        },
                        {
                            "name": "punctuation.definition.arguments.end.denizenscript",
                            "match": "\\]"
                        }
                    ]
                }
            ]
        },
        "commands": {
            "patterns": [
                {
                    "name": "keyword.control.denizenscript",
                    "match": "^\\s*-\\s+([~^]?)([A-Za-z_][A-Za-z0-9_-]*)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.operator.denizenscript"
                        },
                        "2": {
                            "name": "support.function.denizenscript"
                        }
                    }
                },
                {
                    "name": "variable.other.definition.denizenscript",
                    "match": "\\bdef\\.([A-Za-z_][A-Za-z0-9_]*)\\b",
                    "captures": {
                        "1": {
                            "name": "variable.other.readwrite.denizenscript"
                        }
                    }
                }
            ]
        },
        "keys": {
            "patterns": [
                {
                    "name": "meta.event.switch.denizenscript",
                    "match": "^(\\s*)((?:on|after)\\b.*?\\s)([A-Za-z_][A-Za-z0-9_-]*:)([^:\\s]+)(:)\\s*$",
                    "captures": {
                        "2": {
                            "name": "entity.name.section.denizenscript"
                        },
                        "3": {
                            "name": "entity.name.section.denizenscript"
                        },
                        "4": {
                            "name": "constant.language.denizenscript"
                        },
                        "5": {
                            "name": "entity.name.section.denizenscript"
                        }
                    }
                },
                {
                    "name": "meta.event.denizenscript",
                    "match": "^(\\s*)((?:on|after)\\b.*)(:)\\s*$",
                    "captures": {
                        "2": {
                            "name": "entity.name.section.denizenscript"
                        },
                        "3": {
                            "name": "entity.name.section.denizenscript"
                        }
                    }
                },
                {
                    "comment": "The value half gets its own sub-patterns so a tag or a quoted string written on a key line is highlighted as one. Without them this capture swallowed the whole value flat, so `display name: <&b>Test` showed the tag in the plain value colour -- and key lines are where display names, formats and titles are written, which is exactly where tags are commonest. The value also runs to end of line rather than stopping at '#': Denizen has no end-of-line comment (see the note in #comments).",
                    "name": "meta.mapping.value.denizenscript",
                    "match": "^(\\s*)([A-Za-z_][A-Za-z0-9_ -]*)(:\\s*)([^\\r\\n]*)",
                    "captures": {
                        "2": {
                            "name": "entity.name.section.denizenscript"
                        },
                        "3": {
                            "name": "entity.name.section.denizenscript"
                        },
                        "4": {
                            "name": "constant.language.denizenscript",
                            "patterns": [
                                {
                                    "include": "#tags"
                                },
                                {
                                    "include": "#strings"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "meta.mapping.key.denizenscript",
                    "match": "^(\\s*)([A-Za-z_][A-Za-z0-9_ -]*)(:)\\s*$",
                    "captures": {
                        "2": {
                            "name": "entity.name.section.denizenscript"
                        },
                        "3": {
                            "name": "entity.name.section.denizenscript"
                        }
                    }
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.denizenscript",
                    "match": "(==|!=|<=|>=|&&|\\|\\||:->:|:<-:|:\\|:|:\\+\\+|:--|:\\+:|:-:|:\\*:|:/:|[<>:])"
                }
            ]
        }
    }
}
